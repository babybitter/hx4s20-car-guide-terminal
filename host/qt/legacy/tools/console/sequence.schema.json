{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HX4S20 本地播放序列 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": {"const": 1, "type": "integer"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title_id", "dwell_ms", "transition", "cue", "prompt"],
        "properties": {
          "source_id": {"type": "integer", "minimum": 1, "maximum": 128},
          "title_id": {"type": "integer", "minimum": 1, "maximum": 128},
          "dwell_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
          "transition": {"type": "integer", "minimum": 0, "maximum": 7},
          "cue": {"type": "integer", "minimum": 0, "maximum": 4},
          "prompt": {"type": "boolean"}
        }
      }
    }
  }
}
